# PostgreSQL
POSTGRES_DB=sportpartnerboerse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password

# Backend
PORT=3000
FRONTEND_URL=http://localhost:8094

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=changeme
SMTP_FROM=noreply@example.com
SMTP_TLS_REJECT_UNAUTHORIZED=true


# Altcha (HMAC key für Challenge-Generierung und Verifikation im Backend)
ALTCHA_HMAC_KEY=changeme_strong_hmac_key

# Moderation: notifications about new reports go to this address (optional)
MODERATION_EMAIL=

# Admin area (/admin): sign-in with OpenID Connect (authorization code + PKCE).
# Only members of OIDC_ADMIN_GROUP (read from the OIDC_GROUPS_CLAIM claim of the ID token
# or userinfo, dot paths like realm_access.roles work) get access.
# At least 32 random characters, e.g. `openssl rand -hex 32`. Shorter values disable the sign-in.
SESSION_SECRET=
OIDC_ISSUER=https://login.example.org/realms/stupa
OIDC_CLIENT_ID=sportbuddy
OIDC_CLIENT_SECRET=changeme
# Defaults to ${FRONTEND_URL}/api/admin/auth/callback; register this URL at the IdP.
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=STUPA.Sportbuddy.Admin
