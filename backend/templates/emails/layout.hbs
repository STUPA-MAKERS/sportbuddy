<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
</head>
<body style="margin:0;padding:0;background:#f6f7f5;font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif;color:#191c1a;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f7f5;">
    <tr><td align="center" style="padding:32px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
        <tr><td style="padding:0 8px 12px;font-size:13px;color:#666c68;">
          <strong style="color:#191c1a;">Sportbuddy</strong> · STUPA Hochschule Reutlingen
        </td></tr>
        <tr><td style="background:#ffffff;border-radius:24px;padding:32px 36px;">
          <p style="margin:0 0 20px;font-size:17px;font-weight:600;color:#191c1a;">Sportbuddy</p>
          {{{body}}}
        </td></tr>
        <tr><td style="padding:12px 8px 0;font-size:12px;line-height:18px;color:#666c68;">
          {{#if footnote}}{{footnote}}<br>{{/if}}
          STUPA Hochschule Reutlingen · <a href="{{frontendUrl}}" style="color:#3c6a4d;">Zu Sportbuddy</a>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
